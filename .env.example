# AdaptShield Configuration Environment Variables

# Runtime Engine Mode: simulated | live
ADAPTSHIELD_MODE=simulated

# Active Default Classifier: xgboost | random_forest | rule_based
ADAPTSHIELD_DEFAULT_DETECTOR=xgboost

# Containment Response Policy: immediate | manual | none
ADAPTSHIELD_DEFAULT_POLICY=immediate

# Server Port
ADAPTSHIELD_PORT=8000

# SQLite Database Location
ADAPTSHIELD_DB_URL=sqlite:///data/adaptshield.db

# Safety Rails
ADAPTSHIELD_PANIC_STORM_THRESHOLD=5
ADAPTSHIELD_EWMA_ALPHA=0.4
ADAPTSHIELD_CRITICAL_CONFIRM_WINDOWS=2
